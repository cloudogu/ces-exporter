{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "fqdn": {
      "type": "string"
    },
    "isMultinode": {
      "type": "boolean"
    },
    "dogus": {
      "type": "array",
      "items": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "volume": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "sizeInBytes": {
                  "type": "integer"
                }
              },
              "required": [
                "path",
                "sizeInBytes"
              ]
            }
          },
          "required": [
            "name",
            "version",
            "volume"
          ]
        }
      ]
    },
    "packages": {
      "type": "array",
      "items": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "version"
          ]
        }
      ]
    },
    "components": {
      "type": "array",
      "items": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "version"
          ]
        }
      ]
    }
  },
  "required": [
    "fqdn",
    "isMultinode",
    "dogus"
  ]
}